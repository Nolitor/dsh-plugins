{
  "name": "@nolit/dsh-sidebar-manager",
  "version": "0.1.1",
  "private": false,
  "description": "Hard-delete archived sessions, archive workspaces, move sessions, and fork into a new workspace.",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "sidebar",
    "workspace",
    "session",
    "archive",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linuxsung/dsh-sidebar-manager.git"
  },
  "homepage": "https://github.com/linuxsung/dsh-sidebar-manager#readme",
  "license": "MIT",
  "author": "nolit",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/transaction.mjs",
    "lib/session-log.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "market/index.json",
    "market/icons/*.svg",
    "README.md",
    "README.ko.md",
    "package.json",
    "LICENSE",
    "test/promotion.test.mjs",
    "lib/groups.mjs",
    "lib/hq-tree.mjs",
    "lib/batch-validate.mjs",
    "test/safety.test.mjs",
    "test/rollback.test.mjs",
    "test/groups-v2.test.mjs",
    "test/hq-tree.test.mjs",
    "test/manifest.test.mjs",
    "lib/hq-promote.mjs",
    "lib/batch-rename.mjs",
    "lib/orphan-classifier.mjs",
    "lib/harness-diet.mjs",
    "lib/templates/CAPSULE.template.md",
    "lib/templates/AGENTS.sub.template.md",
    "lib/templates/TOOL-REGISTRY.template.md",
    "test/phase5.test.mjs",
    "lib/contract-advisory.mjs",
    "lib/workspace-lifecycle.mjs",
    "test/advisory-v3.test.mjs"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh-package-manifest": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-alpha.2",
    "tsdown": "^0.15.0"
  },
  "bugs": {
    "url": "https://github.com/linuxsung/dsh-sidebar-manager/issues"
  },
  "scripts": {
    "test": "node --test test/manifest.test.mjs test/promotion.test.mjs test/safety.test.mjs test/rollback.test.mjs test/groups-v2.test.mjs test/hq-tree.test.mjs test/phase5.test.mjs test/advisory-v3.test.mjs"
  }
}

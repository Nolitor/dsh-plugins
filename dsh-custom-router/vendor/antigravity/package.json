{
  "name": "@nolit/dsh-antigravity",
  "version": "0.0.1-rc.12",
  "private": false,
  "description": "Antigravity Agent for DeepSeek Harness: one plugin with the /agy CLI worker and agy_worker tool, a pure HTTP model route on the Antigravity subscription (cloudcode-pa, no CLI, no persona), an Antigravity settings section, and a composer usage chip. Master enable plus per-surface switches; English by default, Korean with the host locale.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "antigravity",
    "agy",
    "gemini",
    "cli-worker",
    "llm-adapter"
  ],
  "license": "MIT",
  "author": "nolit",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./auth": {
      "default": "./lib/auth.js"
    },
    "./wire": {
      "default": "./lib/wire.js"
    },
    "./sse": {
      "default": "./lib/sse.js"
    },
    "./map": {
      "default": "./lib/map.js"
    },
    "./usage": {
      "default": "./lib/usage.js"
    },
    "./catalog": {
      "default": "./lib/catalog.js"
    },
    "./adapter": {
      "default": "./lib/adapter.js"
    },
    "./settings": {
      "default": "./lib/settings.js"
    },
    "./backends": {
      "default": "./lib/backends.js"
    },
    "./server": {
      "default": "./lib/server.js"
    },
    "./subagent": {
      "default": "./lib/subagent.js"
    },
    "./subagent-opencode": {
      "default": "./lib/subagent-opencode.js"
    }
  },
  "files": [
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "build": "node scripts/gen-locale.mjs && node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/cli-activation.js && node --check lib/worker.js && node --check lib/auth.js && node --check lib/wire.js && node --check lib/sse.js && node --check lib/map.js && node --check lib/usage.js && node --check lib/catalog.js && node --check lib/adapter.js && node --check lib/settings.js && node --check lib/backends.js && node --check lib/server.js && node --check lib/client.js",
    "docs:index": "node ../scripts/doc-index-track.mjs",
    "docs:check": "node ../scripts/doc-index-track.mjs --check"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.2",
    "@nolit/dsh-custom-router": "0.0.1-rc.16"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^1.0.0"
  }
}

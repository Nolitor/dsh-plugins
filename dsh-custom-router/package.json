{
  "name": "@nolit/dsh-custom-router",
  "version": "0.0.1-rc.9",
  "private": false,
  "description": "Custom Router: the single DSH plugin that owns provider presets, the browser dashboard, the OpenCodex bridge library, and the vendored Antigravity/DeepInfra adapters. Vendor packages are no longer separate profile installs.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "custom-router",
    "model-serving",
    "opencodex",
    "preset"
  ],
  "license": "MIT",
  "type": "module",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./opencodex": {
      "default": "./lib/selection-sync.js"
    },
    "./opencodex-client": {
      "default": "./lib/opencodex-client.js"
    },
    "./selection-projector": {
      "default": "./lib/selection-projector.js"
    },
    "./scope-aggregator": {
      "default": "./lib/scope-aggregator.js"
    },
    "./config": {
      "default": "./lib/config.js"
    },
    "./management-token": {
      "default": "./lib/management-token.js"
    },
    "./vendor-bridge": {
      "default": "./lib/vendor-bridge.js"
    },
    "./package.json": "./package.json",
    "./stream": {
      "default": "./lib/stream/index.js"
    },
    "./stream/sse": {
      "default": "./lib/stream/sse.js"
    },
    "./stream/anthropic": {
      "default": "./lib/stream/anthropic.js"
    },
    "./presets": {
      "default": "./lib/presets.js"
    },
    "./plugin": {
      "default": "./lib/index.js"
    },
    "./catalog": {
      "default": "./lib/catalog.js"
    },
    "./cost": {
      "default": "./lib/cost.js"
    },
    "./routing": {
      "default": "./lib/routing.js"
    },
    "./probe": {
      "default": "./lib/probe.js"
    },
    "./plan": {
      "default": "./lib/plan.js"
    },
    "./usage": {
      "default": "./lib/usage.js"
    },
    "./bridges/antigravity": {
      "default": "./lib/bridges/antigravity.js"
    },
    "./bridges": {
      "default": "./lib/bridges/index.js"
    },
    "./bridges/opencode": {
      "default": "./lib/bridges/opencode.js"
    },
    "./bridges/deepinfra": {
      "default": "./lib/bridges/deepinfra.js"
    },
    "./vendor-modules": {
      "default": "./lib/vendor-modules.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./vendor/antigravity": {
      "default": "./vendor/antigravity/lib/index.js"
    },
    "./vendor/antigravity/auth": {
      "default": "./vendor/antigravity/lib/auth.js"
    },
    "./vendor/antigravity/settings": {
      "default": "./vendor/antigravity/lib/settings.js"
    },
    "./vendor/antigravity/catalog": {
      "default": "./vendor/antigravity/lib/catalog.js"
    },
    "./vendor/deepinfra": {
      "default": "./vendor/deepinfra/lib/index.js"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/",
    "vendor/",
    "locale/",
    "scripts/",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/client.js && node --check lib/settings-schema.js && node --check lib/config.js && node --check lib/opencodex-client.js && node --check lib/management-token.js && node --check lib/selection-projector.js && node --check lib/scope-aggregator.js && node --check lib/selection-sync.js && node --check lib/vendor-bridge.js && node --check lib/stream/index.js && node --check lib/stream/sse.js && node --check lib/stream/usage.js && node --check lib/stream/wire.js && node --check lib/stream/failure.js",
    "docs:check": "node ../scripts/doc-index-track.mjs --check",
    "docs:index": "node ../scripts/doc-index-track.mjs",
    "verify:stream": "node scripts/verify-stream.mjs",
    "verify:stream:json": "node scripts/verify-stream.mjs --json",
    "verify": "npm run check && npm test && npm run verify:stream",
    "verify:presets": "node scripts/verify-presets.mjs",
    "build": "node scripts/gen-locale.mjs && node scripts/build-client.mjs",
    "pretest": "npm run build",
    "verify:dispatch": "node scripts/verify-dispatch-gate.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}

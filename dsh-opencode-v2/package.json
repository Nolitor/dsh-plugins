{
  "name": "@nolit/dsh-opencode-v2",
  "version": "0.1.0",
  "private": false,
  "description": "OpenCode CLI (v2.2.0 surface) inside DeepSeek Harness: an `opencode` delegation tool, a /opencode command, and an `opencode-agent` LLM route — wrapping @quonaro/dsh-plugin-opencode over ctx.subprocess.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "opencode",
    "subagent",
    "delegation"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./provider": {
      "default": "./lib/provider.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/provider.js && node --check lib/shared.js"
  },
  "dependencies": {
    "@quonaro/dsh-plugin-opencode": "^0.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}

{
  "name": "@nolit/dsh-subrouter",
  "version": "0.0.1-rc.1",
  "private": false,
  "description": "Hot-pluggable OpenAI-compatible sub-router provider for DeepSeek Harness. Registers an additional DSH LLM route and removes it automatically on unload, without modifying dsh-llm-pi-ai or any canonical DSH package.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "router",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    ".": {
      "default": "./lib/index.js"
    },
    "./adapter": {
      "default": "./lib/adapter.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "docs/"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/adapter.js",
    "docs:index": "node ../scripts/doc-index-track.mjs",
    "docs:check": "node ../scripts/doc-index-track.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2"
  }
}

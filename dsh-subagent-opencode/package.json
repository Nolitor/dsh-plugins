{
  "name": "@nolit/dsh-subagent-opencode",
  "version": "0.0.1-rc.1",
  "private": false,
  "description": "OpenCode subagent provider for DeepSeek Harness: one isolated CLI delegation per call, exposed as the subagent_opencode tool.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "opencode",
    "subagent"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-subagent": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}

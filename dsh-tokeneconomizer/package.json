{
  "name": "@nolit/dsh-tokeneconomizer",
  "version": "0.0.1-rc.6",
  "description": "TokenEconomizer for the DeepSeek Harness: session micro-skills, evidence-based tool pruning applied as an in-memory restriction, and a tool-loop guard, bridged to the stdlib-only Python engine through its own te/te-hook launchers, plus host-local in-memory features: tool-result hash deduplication, a KV-cache-safe prompt slot with constant Think-in-Code routing, a loop breaker with an advisory thinking watchdog, turn-based output tiering, prior-session recall through the harness's own FTS5 index, and the engine's repository-key mapping. Zero runtime imports outside node: builtins.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "tokeneconomizer",
    "cost",
    "tokens"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "te-dsh": "./bin/te-dsh.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./bridge": "./lib/bridge.js",
    "./repokey": "./lib/repokey.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/ko.json": "./locale/ko.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/",
    "bin/",
    "scripts/",
    "patch/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "locale/",
    "docs/"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "audit:deprecations": "node scripts/audit-deprecations.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "cold-start": "node bin/te-dsh.mjs cold-start",
    "docs:index": "node ../scripts/doc-index-track.mjs",
    "docs:check": "node ../scripts/doc-index-track.mjs --check"
  }
}

+"""The DSH reader: one exported session log -> calls, usage, prompts, Claude transcript."""
+import json
+import os
+import tempfile
+import unittest
+
+from tokeneconomizer import trace
+
+
+def _export(path, events, header=None, sid="session-1"):
+    lines = [json.dumps(header or {"type": "session", "version": 4, "id": sid,
+                                   "createdAt": 1792, "cwd": "/repo"})]
+    lines.extend(json.dumps(ev) for ev in events)
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write("\n".join(lines) + "\n")
+    return path
+
+
+def _events():
+    return [
+        {"type": "turn/start", "seq": 0, "time": 1, "data": {"turn": 1}},
+        {"type": "user/message", "seq": 1, "time": 2, "data": {
+            "id": "u1", "role": "user", "content": [{"type": "text", "text": "fix it"}],
+            "source": {"kind": "user"}}},
+        {"type": "user/message", "seq": 2, "time": 3, "data": {
+            "id": "u2", "role": "user", "content": [{"type": "text", "text": "injected"}],
+            "source": {"kind": "system-prompt"}}},
+        {"type": "assistant/message", "seq": 3, "time": 4, "data": {
+            "turn": 1, "step": 1,
+            "message": {"id": "a1", "role": "assistant",
+                        "content": [{"type": "text", "text": "running"},
+                                    {"type": "reasoning", "text": "why"}],
+                        "source": {"kind": "model", "provider": "deepseek-account",
+                                   "model": "deepseek-v4.1-flash"}},
+            "usage": {"inputTokens": 1000, "outputTokens": 50, "totalTokens": 1163,
+                      "cacheReadTokens": 113}}},
+        {"type": "tool/call", "seq": 4, "time": 5, "data": {
+            "turn": 1, "step": 1, "callId": "c1", "name": "bash",
+            "arguments": json.dumps({"command": "python -m pytest -q"})}},
+        {"type": "tool/result", "seq": 5, "time": 6, "data": {
+            "turn": 1, "step": 1,
+            "message": {"id": "t1", "role": "tool", "toolCallId": "c1", "isError": True,
+                        "content": [{"type": "text", "text": "1 failed"}],
+                        "source": {"kind": "tool", "callId": "c1"}}}},
+    ]
+
+
+class DshTraceTest(unittest.TestCase):
+    def test_conversion_pairs_calls_and_results(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            src = _export(os.path.join(tmp, "s.jsonl"), _events())
+            out = os.path.join(tmp, "trace.jsonl")
+            self.assertEqual(trace.dsh_session_to_claude(src, out), 1)
+            with open(out, encoding="utf-8") as fh:
+                lines = [json.loads(line) for line in fh]
+            kinds = [line["type"] for line in lines]
+            self.assertEqual(kinds, ["user", "user", "assistant", "user"])
+            assistant = lines[2]["message"]
+            self.assertEqual(assistant["model"], "deepseek-v4.1-flash")
+            self.assertEqual(assistant["content"][-1]["name"], "bash")
+            self.assertEqual(assistant["content"][-1]["input"], {"command": "python -m pytest -q"})
+            self.assertEqual(lines[3]["message"]["content"][0]["tool_use_id"], "c1")
+            self.assertTrue(lines[3]["message"]["content"][0]["is_error"])
+            # The mechanisms read the converted file with the Claude reader.
+            calls = trace.load_trajectory(out)
+            self.assertEqual(calls[0][0], "bash")
+            self.assertEqual(calls[0][1], {"command": "python -m pytest -q"})
+            self.assertEqual(calls[0][2], "1 failed")
+            self.assertFalse(calls[0][3])
+
+    def test_usage_and_prompts(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            src = _export(os.path.join(tmp, "s.jsonl"), _events())
+            usage = trace.dsh_session_usage(src)
+            self.assertEqual(usage["input_tokens"], 1000)
+            self.assertEqual(usage["cache_read_input_tokens"], 113)
+            self.assertEqual(usage["output_tokens"], 50)
+            self.assertEqual(usage["requests"], 1)
+            self.assertEqual(usage["model"], "deepseek-v4.1-flash")
+            self.assertEqual(trace.dsh_prompt_count(src), 1)
+
+    def test_usage_deduplicates_a_repeated_message(self):
+        events = _events()
+        events.append(dict(events[3], seq=9))
+        with tempfile.TemporaryDirectory() as tmp:
+            src = _export(os.path.join(tmp, "s.jsonl"), events)
+            self.assertEqual(trace.dsh_session_usage(src)["requests"], 1)
+            self.assertEqual(trace.dsh_session_usage(src)["input_tokens"], 1000)
+
+    def test_header_and_missing_file(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            src = _export(os.path.join(tmp, "s.jsonl"), _events(), sid="session-9")
+            self.assertEqual(trace.dsh_export_header(trace.dsh_session_header(src))[0], "session-9")
+            self.assertIsNone(trace.dsh_session_to_claude(os.path.join(tmp, "nope"),
+                                                         os.path.join(tmp, "out")))
+
+
+class DshProtectionTest(unittest.TestCase):
+    def test_a_person_s_tools_are_protected_under_dsh_names(self):
+        from tokeneconomizer.plugin.adapter import LiveAdapter
+        from tokeneconomizer.plugin.hosts import DSH
+        protected = LiveAdapter(DSH(), "/repo").protected_tools()
+        for name in ("ask_user_question", "todo_write", "web_search", "web_fetch",
+                     "subagent", "send_message", "team_task_create", "exit_plan_mode",
+                     "present", "job_output"):
+            self.assertIn(name, protected)
+        # Work-surface tools of every ecosystem stay prunable candidates only when never used;
+        # nothing here denies the category, it only protects a person's controls.
+        self.assertNotIn("cordis_inspect_query", protected)

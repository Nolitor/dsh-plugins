@@ -0,0 +1,228 @@
+"""DeepSeek Harness (DSH, `dsh`): a session exported as JSONL.
+
+DSH keeps each session as a compressed append-only log, `session.v<N>.jsonl.zstd` under
+`$DSH_HOME/sessions/<project>/<session>/`. The compression moves between format generations, and
+the file is private to the harness, so the DSH plugin writes a *decompressed* copy of that log
+beside the other state when a session ends (`$TOKENECONOMIZER_HOME/dsh-sessions/<id>.jsonl`) and
+this module reads the copy. A decompressed native log reads the same way, which is what the
+plugin's cold-start import uses.
+
+The export is the harness's own JSONL: one header line, then one event per line.
+
+    {"type": "session", "version": 4, "id": "session-…", "createdAt": 1792…, "cwd": "/repo"}
+    {"type": "user/message", "seq": 7, "time": 1792…, "data": {…}}
+    {"type": "assistant/message", …, "data": {"turn": 1, "step": 1,
+        "message": {"id": "…", "role": "assistant",
+                    "content": [{"type": "text", …}, {"type": "reasoning", …}],
+                    "source": {"kind": "model", "provider": "…", "model": "…"}},
+        "usage": {"inputTokens": 16832, "outputTokens": 94, "totalTokens": 17039,
+                  "cacheReadTokens": 113}}}
+    {"type": "tool/call", …, "data": {"turn": 1, "step": 1, "callId": "…",
+                                      "name": "bash", "arguments": "{\\"command\\": \\"…\\"}"}}
+    {"type": "tool/result", …, "data": {"turn": 1, "step": 1,
+        "message": {"role": "tool", "toolCallId": "…",
+                    "content": [{"type": "text", "text": "…"}], "isError": false}}}
+
+What the mechanisms read, by event:
+
+  * `tool_name` — `tool/call.data.name` (the registered model-facing name: `bash`, `read`,
+    `write`, `edit`, `grep`, `glob`, an MCP tool's name, …);
+  * `status` — `tool/result.data.message.isError` (absent means success);
+  * `tokens` — `assistant/message.data.usage`, one per model request. DSH counts a cached read
+    in `cacheReadTokens` and a cache write in `cacheWriteTokens`, never inside `inputTokens`, so
+    the four ledger fields map one to one. `outputTokens` is used as recorded; a separate
+    `reasoningTokens` counter is not added, because the harness already reports it inside the
+    provider's output total when the provider does.
+
+Usage is keyed by assistant message id: a resumed or compacted log can repeat a request's
+message envelope, and summing lines would price that request twice.
+
+`dsh_session_to_claude` writes the conversation as the Claude Code envelope the other readers
+already handle, so no mechanism needs a DSH branch.
+"""
+import json
+import os
+
+
+def _events(path):
+    """(header, [event]) of an export; ({}, []) when it cannot be read."""
+    header, events = {}, []
+    try:
+        fh = open(path, encoding="utf-8", errors="replace")
+    except OSError:
+        return header, events
+    with fh:
+        for line in fh:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                ev = json.loads(line)
+            except ValueError:
+                continue
+            if not isinstance(ev, dict):
+                continue
+            if ev.get("type") == "session" and not events and not header:
+                header = ev
+                continue
+            if isinstance(ev.get("data"), dict) and ev.get("type"):
+                events.append(ev)
+    return header, events
+
+
+def dsh_session_header(path):
+    """The `{"type": "session", …}` header of an export, {} when it carries none."""
+    return _events(path)[0]
+
+
+def _text_of(content):
+    """The text blocks of a message's content, joined; non-text blocks are ignored."""
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        return ""
+    return "\n".join(b.get("text", "") for b in content
+                     if isinstance(b, dict) and b.get("type") == "text" and b.get("text"))
+
+
+def dsh_prompt_count(path):
+    """How many prompts the person gave the session: `user/message` events from the person.
+
+    DSH writes injected context as user-role messages too (`source.kind` names the producer);
+    only `{"kind": "user"}` is a prompt the person typed.
+    """
+    return sum(1 for ev in _events(path)[1]
+               if ev["type"] == "user/message"
+               and (ev["data"].get("source") or {}).get("kind") == "user"
+               and _text_of(ev["data"].get("content")).strip())
+
+
+def _assistant_usage(usage):
+    """The four ledger fields of one DSH `usage` record, or None without input tokens."""
+    if not isinstance(usage, dict) or usage.get("inputTokens") is None:
+        return None
+    return {"input_tokens": int(usage.get("inputTokens") or 0),
+            "cache_read_input_tokens": int(usage.get("cacheReadTokens") or 0),
+            "cache_creation_input_tokens": int(usage.get("cacheWriteTokens") or 0),
+            "output_tokens": int(usage.get("outputTokens") or 0)}
+
+
+def dsh_session_usage(path):
+    """Token breakdown of a DSH session, plus the model and the request count.
+
+    One request is one `assistant/message` carrying usage, de-duplicated by message id.
+    """
+    totals = {"input_tokens": 0, "cache_read_input_tokens": 0,
+              "cache_creation_input_tokens": 0, "output_tokens": 0}
+    models, seen, requests = {}, set(), 0
+    for ev in _events(path)[1]:
+        if ev["type"] != "assistant/message":
+            continue
+        data = ev["data"]
+        u = _assistant_usage(data.get("usage"))
+        if u is None:
+            continue
+        msg_id = (data.get("message") or {}).get("id")
+        if msg_id is not None:
+            if msg_id in seen:
+                continue
+            seen.add(msg_id)
+        requests += 1
+        for k in totals:
+            totals[k] += u[k]
+        model = ((data.get("message") or {}).get("source") or {}).get("model")
+        if model:
+            models[model] = models.get(model, 0) + 1
+    totals.update(requests=requests,
+                  model=max(models, key=models.get) if models else None)
+    return totals
+
+
+def dsh_session_to_claude(path, out_path):
+    """Write a DSH export as Claude Code transcript lines.
+
+    Returns the number of tool calls written, or None when the file is missing or holds no
+    messages. Tool calls are grouped by their step, so each assistant line carries the calls
+    the model requested there and each call's result follows as the next user line.
+    """
+    if not path or not os.path.exists(path):
+        return None
+    _, events = _events(path)
+    if not events:
+        return None
+
+    calls, results = {}, {}
+    for ev in events:
+        data = ev["data"]
+        if ev["type"] == "tool/call":
+            calls.setdefault(data.get("callId"), {
+                "turn": data.get("turn"), "step": data.get("step"),
+                "name": data.get("name"), "args": data.get("arguments")})
+        elif ev["type"] == "tool/result":
+            msg = data.get("message") or {}
+            results.setdefault(msg.get("toolCallId") or data.get("callId"), {
+                "text": _text_of(msg.get("content")),
+                "is_error": bool(msg.get("isError"))})
+
+    n = 0
+    with open(out_path, "w", encoding="utf-8") as out:
+        pending = None            # {turn, step, call ids} of the assistant line just written
+
+        def flush():
+            """Write the results of the calls the previous assistant line requested."""
+            nonlocal pending
+            if not pending:
+                return
+            for call_id in pending["ids"]:
+                res = results.get(call_id) or {"text": "", "is_error": False}
+                out.write(json.dumps({"type": "user", "message": {
+                    "role": "user", "content": [{
+                        "type": "tool_result", "tool_use_id": call_id,
+                        "content": res["text"], "is_error": res["is_error"]}]}}) + "\n")
+            pending = None
+
+        for ev in events:
+            data = ev["data"]
+            if ev["type"] == "user/message":
+                text = _text_of(data.get("content"))
+                if text.strip():
+                    flush()
+                    out.write(json.dumps({"type": "user", "message": {
+                        "role": "user", "content": text}}) + "\n")
+            elif ev["type"] == "assistant/message":
+                flush()
+                msg = data.get("message") or {}
+                ids = [cid for cid, c in calls.items()
+                       if c["turn"] == data.get("turn") and c["step"] == data.get("step")]
+                blocks = []
+                text = _text_of(msg.get("content"))
+                if text:
+                    blocks.append({"type": "text", "text": text})
+                for call_id in ids:
+                    c = calls[call_id]
+                    try:
+                        args = json.loads(c["args"] or "{}")
+                    except (TypeError, ValueError):
+                        args = {}
+                    blocks.append({"type": "tool_use", "id": call_id,
+                                   "name": c["name"], "input": args})
+                    n += 1
+                entry = {"id": msg.get("id"), "role": "assistant", "content": blocks,
+                         "model": (msg.get("source") or {}).get("model")}
+                usage = _assistant_usage(data.get("usage"))
+                if usage:
+                    entry["usage"] = usage
+                line = {"type": "assistant", "message": entry}
+                cwd = (data.get("cwd") or (msg.get("source") or {}).get("cwd"))
+                if isinstance(cwd, str) and cwd:
+                    line["cwd"] = cwd
+                out.write(json.dumps(line) + "\n")
+                pending = {"turn": data.get("turn"), "step": data.get("step"), "ids": ids}
+        flush()
+    return n
+
+
+def dsh_export_header(header):
+    """(session id, cwd, created-at) of an export header, for the plugin's cold-start import."""
+    return (str(header.get("id") or ""), header.get("cwd") or "",
+            header.get("createdAt"))

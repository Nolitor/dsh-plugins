+class DSH(Host):
+    """DeepSeek Harness (`dsh`), through the plugin in `plugin/` of this repository's DSH port.
+
+    DSH has no hook protocol of its own: its plugins are Cordis plugins with scoped
+    registrations, so `@nolit/dsh-tokeneconomizer` speaks THIS one on DSH's behalf, as the
+    opencode and Pi integrations do. It calls the same dispatcher with a Claude-shaped payload
+    per lifecycle event and applies the answer with DSH's own levers (a scoped system-prompt
+    context, an injected user message, an in-memory tool restriction). What it sends:
+
+      * `prompt_id`, numbered by the plugin, because DSH stamps `turn` but not a prompt id;
+      * `transcript_path`, a decompressed copy of the session log written at each turn end and
+        at disposal (`trace/dsh.py` reads it);
+      * `tool_response = {content, isError, exit_code}`, where `isError` is the tool result's
+        own flag and `exit_code` is read from the rendered result when it names one;
+      * DSH's mode in `TE_DSH_MODE`: `headless` for `dsh headless …`, else `interactive`.
+    """
+    name = "dsh"
+    prompt_context = True              # the plugin supplies the learned facts as prompt context
+    interrupt = "Press Esc to interrupt the turn."
+    end_run = "Press Ctrl+C to end the run."
+
+    def turn_key(self, p):
+        return str(p.get("prompt_id") or "")
+
+    def headless(self, env, transcript=None):
+        return str(env.get("TE_DSH_MODE", "")).strip() == "headless"
+
+    def tool_call(self, p):
+        name, args, text, code = super().tool_call(p)
+        if name == "str_replace_editor":
+            # DSH keeps a str_replace-style editor beside `edit`; the guard counts edits.
+            return "str_replace", args, text, code
+        return name, args, text, code
+
+    def mechanism_trace(self, transcript_path, workdir):
+        out = os.path.join(workdir, "dsh_trace.jsonl")
+        n = trace.dsh_session_to_claude(transcript_path, out)
+        return out if n is not None else None
+
+    def prompt_count(self, transcript_path):
+        return trace.dsh_prompt_count(transcript_path)
+
+    def session_usage(self, transcript_path):
+        return trace.dsh_session_usage(transcript_path)
+

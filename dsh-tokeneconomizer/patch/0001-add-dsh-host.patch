+def dsh_call(prompt, model="", cli="dsh", profile="headless", timeout=TIMEOUT_S):
+    """A side call through DSH's own headless profile, in a throwaway directory.
+
+    `dsh --profile headless --json <prompt>` writes newline-delimited run events; its terminal
+    `final` event carries the answer, and each `status` event of phase `step_end` carries that
+    step's `usage` in DSH's own counters (`inputTokens`, `outputTokens`, `cacheReadTokens`,
+    `cacheWriteTokens`). The call exports `TE_DISABLE=1` so the DSH TokenEconomizer plugin does
+    nothing inside it, and `TE_SIDECALL=1` like every other side call.
+
+    A model override is not passed: DSH chooses the agent preset's route, which is the person's
+    own default. The call is billed where the person's DSH is billed; the ledger charges the
+    tokens DSH reports.
+
+    The throwaway directory is also the call's session store: a `--patch` overlay re-roots
+    `session-persistence-jsonl` at `<cwd>/sessions`, so the Session log dies with the directory.
+    Without it DSH writes one permanent workspace-shaped session directory per call under
+    `~/.dsh/sessions/--tmp-te-side-*`, at a cwd that no longer exists -- measured 119 of 130
+    session directories on 2026-11-03, essentially all of them the loop guard's judge.
+    """
+    cmd = [cli, "--profile", profile, "--json", prompt]
+    out_usage = None
+    text = ""
+    with tempfile.TemporaryDirectory(prefix="te-side-") as cwd:
+        # Keep the Session DSH is about to persist inside the directory this block deletes.
+        overlay = os.path.join(cwd, ".te-session-store.yml")
+        with open(overlay, "w", encoding="utf-8") as fh:
+            for entry, sub in (("session-persistence-jsonl", "sessions"),
+                               ("storage-json", "storages")):

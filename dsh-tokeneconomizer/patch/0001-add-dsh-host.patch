+def cmd_dsh_import(args):
+    """Record and fold one finished DSH session from its decompressed log.
+
+    The plugin's cold-start pass walks the harness's stored sessions, decompresses each one and
+    calls this command once per session, so what a person's earlier DSH sessions taught is in
+    the state before the first new one runs. A session already folded is not folded again
+    (`fold_session` keys by id).
+    """
+    path = os.path.abspath(args.export)
+    if not os.path.exists(path):
+        print(json.dumps({"error": f"no such export: {path}"}))
+        return 1
+    header = trace.dsh_session_header(path)
+    sid, cwd, created = trace.dsh_export_header(header)
+    sid = args.session or sid
+    if not sid:
+        print(json.dumps({"error": f"{path} carries no session id; pass --session"}))
+        return 1
+    cwd = cwd or args.cwd
+    ctx = LiveContext.build(hosts.DSH(), cwd, os.environ, session_id=sid)
+    started = (float(created) / 1000.0) if created else time.time()
+    ctx.store.write(os.path.join("sessions", f"{sid}.json"), {
+        "session_id": sid, "host": ctx.host.name, "started": started, "cwd": cwd,
+        "transcript": path, "ended": time.time(), "imported": True,
+        "turns": [], "nudges": 0, "aborts": 0, "judge_tokens": 0, "writer_tokens": 0})
+    rec = fold.fold_session(ctx, sid, transcript_path=path)
+    print(json.dumps({"session": sid, "repo": ctx.repo.label, "root": ctx.repo.root,
+                      "folded": rec is not None,
+                      "record": ({k: rec.get(k) for k in (
+                          "error", "prompts", "turns", "injection", "untool",
+                          "effective_tokens", "priced_by", "model")} if rec else None)},
+                     default=str))
+    return 0
+
+

+def cmd_dsh_session(args):
+    """The one call the DSH plugin makes at session start: one JSON object with what to inject,
+    which tools to leave out, and whether the guard is live. Fails open like a hook: a missing
+    state file is an empty answer, not an error."""
+    ctx = _ctx(args)
+    cfg = ctx.config
+    if args.tools:
+        # The plugin reports the model-facing tools this DSH assembly registers, so evidence
+        # pruning has the full catalog, not only the tools a session happened to call. Written
+        # only when it changes; no model call, no probe process.
+        tools = sorted({t.strip() for t in args.tools.split(",") if t.strip()})
+        path = live_adapter.catalog_path(ctx.root, ctx.host.name)
+        try:
+            prior = (json.load(open(path, encoding="utf-8")) or {}).get("tools")
+        except (OSError, ValueError):
+            prior = None
+        if tools and tools != prior:
+            denylist.write_json(path, {"tools": tools, "probed_by": "dsh-plugin",
+                                       "probed_at": time.time()})
+    out = {"host": ctx.host.name, "shadow": bool(cfg.shadow),
+           "repo": {"label": ctx.repo.label, "root": ctx.repo.root, "key": ctx.repo.key},
+           "microskills": {"profile": cfg.microskills, "text": "", "facts": 0},
+           "toolprune": {"mode": cfg.toolprune, "proposal": []},
+           "loopguard": {"mode": cfg.loopguard, "envelope": None}}
+    inj = ctx.store.read("injection.json") or {}
+    if cfg.microskills != "off" and not cfg.shadow:
+        text = inj.get("rendered") or ""
+        out["microskills"]["text"] = text
+        out["microskills"]["facts"] = sum(1 for ln in text.splitlines() if ln.startswith("- "))
+    unt = ctx.store.read("untool.json") or {}
+    out["toolprune"]["proposal"] = list(unt.get("proposal") or [])
+    try:
+        out["loopguard"]["envelope"] = loopguard.load_envelope(
+            ctx.store, cfg.loopguard_aggr, cfg.loopguard_thresholds).envelope
+    except (OSError, ValueError):
+        out["loopguard"]["envelope"] = None
+    print(json.dumps(out, default=str))
+    return 0
+

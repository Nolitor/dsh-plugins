{
  "name": "dsh-plugins-workspace",
  "private": true,
  "type": "module",
  "description": "DSH Plugins workspace maintenance scripts (documentation index, boot cards).",
  "scripts": {
    "docs:index": "node scripts/doc-index.mjs",
    "docs:check": "node scripts/doc-index.mjs --check && node scripts/check-doc-links.mjs --quiet && node scripts/check-doc-moves.mjs --quiet",
    "bootcard": "node scripts/new-bootcard.mjs",
    "docs:new": "node scripts/new-doc.mjs",
    "dsh:isolation": "node scripts/check-dsh-isolation.mjs",
    "test:isolation": "node --test scripts/check-dsh-isolation.test.mjs scripts/cleanup-orphan-sessions.test.mjs",
    "cleanup:orphans": "node scripts/cleanup-orphan-sessions.mjs",
    "docs:check:all": "npm run docs:check && node scripts/check-plugin-history.mjs && node scripts/check-disposal-safety.mjs && npm run test:docs && npm run check:publish && npm run verify:presets:static && npm run verify:presets:mutation",
    "docs:links": "node scripts/check-doc-links.mjs",
    "test:docs": "node --test scripts/check-doc-links.test.mjs",
    "docs:moves": "node scripts/check-doc-moves.mjs",
    "test:disposal": "node --test scripts/check-disposal-safety.test.mjs",
    "check:disposal": "node scripts/check-disposal-safety.mjs",
    "check:publish": "node scripts/check-npm-publishable.mjs",
    "publish:dry": "scripts/publish-npm.sh --dry-run",
    "link:custom-router": "node scripts/link-custom-router.mjs",
    "verify:presets": "node dsh-custom-router/scripts/verify-presets.mjs",
    "verify:presets:mutation": "node dsh-custom-router/scripts/verify-presets-mutation.mjs",
    "verify:presets:static": "node dsh-custom-router/scripts/verify-presets.mjs --static-only"
  }
}
